-- Source: html-visuals skill — full-frame HTML/SVG via htmlContent custom visual
-- Visual type: htmlContent443BE3AD55E043BF878BED274D3A6855
-- dataCategory: ImageUrl required on this measure in TMDL
-- Adapt table/column references to match your model before use.
--
-- Template: Executive KPI header strip — 4 boxes (HTML visual)
-- Renders a compact horizontal header with:
--   Box 1: TCO Actual (Time Intelligence)
--   Box 2: Previous Period value
--   Box 3: Absolute delta (M€)
--   Box 4: Variation % (color-coded green/red)
-- Place at the top of the Executive Report page.
-- Prerequisites:
--   [TCO Actual TI], [TCO PP TI], [TCO Delta TI], [TCO Delta% TI]
--   [TCO Score Color TI]  — returns hex color string based on variation
--   Set visual dataCategory = ImageUrl in TMDL.

HTML Executive Header =
VAR _actual    = [TCO Actual TI]
VAR _pp        = [TCO PP TI]
VAR _delta     = [TCO Delta TI]
VAR _deltaPct  = [TCO Delta% TI]
VAR _color     = [TCO Score Color TI]
VAR _actualFmt  = IF(ISBLANK(_actual),  "—", FORMAT(_actual/1000000,  "#,##0.0") & " M€")
VAR _ppFmt      = IF(ISBLANK(_pp),      "—", FORMAT(_pp/1000000,      "#,##0.0") & " M€")
VAR _deltaFmt   = IF(ISBLANK(_delta),   "—", FORMAT(_delta/1000000,   "+#,##0.0;-#,##0.0") & " M€")
VAR _deltaPctFmt= IF(ISBLANK(_deltaPct),"—", FORMAT(_deltaPct,        "+0.0%;-0.0%"))
RETURN
"<html><head><style>"
& "* { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',sans-serif; }"
& "body { background:#1A5525; display:flex; align-items:center; height:100%; padding:0 24px; gap:8px; }"
& ".kpi { flex:1; background:#FFFFFF; border-radius:8px; padding:12px 16px; border:1px solid rgba(255,255,255,0.12); }"
& ".kpi-label { color:#3D7050; font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:0.8px; }"
& ".kpi-value { color:#3D7050; font-size:20px; font-weight:700; margin-top:4px; }"
& ".kpi-delta { font-size:18px; font-weight:700; color:" & _color & "; }"
& "</style></head><body>"
& "<div class='kpi'><div class='kpi-label'>TCO Actual</div><div class='kpi-value'>" & _actualFmt & "</div></div>"
& "<div class='kpi'><div class='kpi-label'>Periodo Precedente</div><div class='kpi-value'>" & _ppFmt & "</div></div>"
& "<div class='kpi'><div class='kpi-label'>Delta</div><div class='kpi-value'>" & _deltaFmt & "</div></div>"
& "<div class='kpi'><div class='kpi-label'>Var %</div><div class='kpi-value kpi-delta'>" & _deltaPctFmt & "</div></div>"
& "</body></html>"
