table _Measures
	lineageTag: b97a06bc-b755-4a8f-8b05-3a7467ee6063

	measure 'Sales Amount' =
			SUM(Fact_Sales[Sales Amount LC])
		formatString: #,##0.00
		displayFolder: Sales
		lineageTag: 2fd1d259-7eeb-49df-86b5-f711564a7711

	measure 'Adjusted Profit' =
			SUM(Fact_Sales[Adjusted Profit LC])
		formatString: #,##0.00
		displayFolder: Profitability
		lineageTag: 453b7f57-17ac-43e2-a525-8628d89c6c79

	measure 'Item Profit' =
			SUM(Fact_Sales[Item Profit LC])
		formatString: #,##0.00
		displayFolder: Profitability
		lineageTag: e879b9c9-3cbe-4984-8acc-14ab8ed79481

	measure 'Resource Profit' =
			SUM(Fact_Sales[Resource Profit LC])
		formatString: #,##0.00
		displayFolder: Profitability
		lineageTag: 1882050b-a8f3-4f65-a056-c9b6938ee146

	measure 'Discount Amount' =
			SUM(Fact_Sales[Discount Amount LC])
		formatString: #,##0.00
		displayFolder: Sales
		lineageTag: 8a21188f-cf69-423b-b304-02442280f9b6

	measure 'Budget Amount' =
			SUM(Fact_Budget[Budget Amount LC])
		formatString: #,##0.00
		displayFolder: Budget
		lineageTag: 4f37ba92-9662-4e16-aecb-426a04b0d337

	measure 'Sales Amount FYTD' =
			// Calculate fiscal year-to-date sales using dynamic fiscal year parameter
			VAR CurrentDate = MAX(Dim_Date[Date])
			VAR FYStartMonth = VALUE(SELECTEDVALUE(Parameters[ParameterValue], "1"))
			VAR CurrentYear = YEAR(CurrentDate)
			VAR CurrentMonth = MONTH(CurrentDate)
			// Calculate current fiscal year
			VAR FiscalYear = 
				IF(
					CurrentMonth >= FYStartMonth,
					CurrentYear,
					CurrentYear - 1
				)
			VAR FYStartDate = DATE(FiscalYear, FYStartMonth, 1)
			VAR FYTDSales =
				CALCULATE(
					[Sales Amount],
					FILTER(
						ALL(Dim_Date[Date]),
						Dim_Date[Date] >= FYStartDate && Dim_Date[Date] <= CurrentDate
					)
				)
			RETURN
				FYTDSales
		formatString: #,##0.00
		displayFolder: Time Intelligence
		lineageTag: 14816c98-276b-4723-b0d9-94216e86e02d

	measure 'Budget Amount FYTD' =
			// Calculate fiscal year-to-date budget using dynamic fiscal year parameter
			VAR CurrentDate = MAX(Dim_Date[Date])
			VAR FYStartMonth = VALUE(SELECTEDVALUE(Parameters[ParameterValue], "1"))
			VAR CurrentYear = YEAR(CurrentDate)
			VAR CurrentMonth = MONTH(CurrentDate)
			// Calculate current fiscal year
			VAR FiscalYear = 
				IF(
					CurrentMonth >= FYStartMonth,
					CurrentYear,
					CurrentYear - 1
				)
			VAR FYStartDate = DATE(FiscalYear, FYStartMonth, 1)
			VAR FYTDBudget =
				CALCULATE(
					[Budget Amount],
					FILTER(
						ALL(Dim_Date[Date]),
						Dim_Date[Date] >= FYStartDate && Dim_Date[Date] <= CurrentDate
					)
				)
			RETURN
				FYTDBudget
		formatString: #,##0.00
		displayFolder: Time Intelligence
		lineageTag: f0188ea9-dc8d-4b76-923a-343e420d31ff

	measure 'Adjusted Profit FYTD' =
			// Calculate fiscal year-to-date adjusted profit using dynamic fiscal year parameter
			VAR CurrentDate = MAX(Dim_Date[Date])
			VAR FYStartMonth = VALUE(SELECTEDVALUE(Parameters[ParameterValue], "1"))
			VAR CurrentYear = YEAR(CurrentDate)
			VAR CurrentMonth = MONTH(CurrentDate)
			// Calculate current fiscal year
			VAR FiscalYear = 
				IF(
					CurrentMonth >= FYStartMonth,
					CurrentYear,
					CurrentYear - 1
				)
			VAR FYStartDate = DATE(FiscalYear, FYStartMonth, 1)
			VAR FYTDProfit =
				CALCULATE(
					[Adjusted Profit],
					FILTER(
						ALL(Dim_Date[Date]),
						Dim_Date[Date] >= FYStartDate && Dim_Date[Date] <= CurrentDate
					)
				)
			RETURN
				FYTDProfit
		formatString: #,##0.00
		displayFolder: Time Intelligence
		lineageTag: aefa3752-56c8-43b0-900d-16c24dec7c58

	measure 'Sales vs Budget' =
			VAR ActualSales = [Sales Amount FYTD]
			VAR BudgetAmount = [Budget Amount FYTD]
			VAR VarianceAmount = ActualSales - BudgetAmount
			RETURN
				VarianceAmount
		formatString: #,##0.00
		displayFolder: Budget
		lineageTag: aaf18fb8-d316-401a-b172-383c8ee764bb

	measure 'Sales vs Budget %' =
			VAR ActualSales = [Sales Amount FYTD]
			VAR BudgetAmount = [Budget Amount FYTD]
			VAR VariancePct = 
				DIVIDE(
					ActualSales - BudgetAmount,
					BudgetAmount,
					BLANK()
				)
			RETURN
				VariancePct
		formatString: 0.00%
		displayFolder: Budget
		lineageTag: 9e1abf59-a931-4be5-af6c-b021862b43f3

	measure 'Adjusted Profit %' =
			VAR TotalSales = [Sales Amount]
			VAR TotalProfit = [Adjusted Profit]
			VAR ProfitPct = 
				DIVIDE(
					TotalProfit,
					TotalSales,
					BLANK()
				)
			RETURN
				ProfitPct
		formatString: 0.00%
		displayFolder: Profitability
		lineageTag: 48f01bbc-4e29-42a9-a59f-1eb120c6f2c1

	measure 'Item Profit %' =
			VAR TotalSales = [Sales Amount]
			VAR ItemProfitTotal = [Item Profit]
			VAR ItemProfitPct = 
				DIVIDE(
					ItemProfitTotal,
					TotalSales,
					BLANK()
				)
			RETURN
				ItemProfitPct
		formatString: 0.00%
		displayFolder: Profitability
		lineageTag: d88a7a0f-51b6-4f30-beb2-5ef3ce9eb6de

	measure 'Resource Profit %' =
			VAR TotalSales = [Sales Amount]
			VAR ResourceProfitTotal = [Resource Profit]
			VAR ResourceProfitPct = 
				DIVIDE(
					ResourceProfitTotal,
					TotalSales,
					BLANK()
				)
			RETURN
				ResourceProfitPct
		formatString: 0.00%
		displayFolder: Profitability
		lineageTag: d67c6920-4ec2-4260-b9bf-8f2a44c2b40f

	measure 'Average Monthly Sales' =
			// Calculate average monthly sales in fiscal YTD period
			VAR TotalFYTDSales = [Sales Amount FYTD]
			VAR CurrentDate = MAX(Dim_Date[Date])
			VAR FYStartMonth = VALUE(SELECTEDVALUE(Parameters[ParameterValue], "1"))
			VAR CurrentYear = YEAR(CurrentDate)
			VAR CurrentMonth = MONTH(CurrentDate)
			// Calculate current fiscal year
			VAR FiscalYear = 
				IF(
					CurrentMonth >= FYStartMonth,
					CurrentYear,
					CurrentYear - 1
				)
			VAR FYStartDate = DATE(FiscalYear, FYStartMonth, 1)
			VAR MonthCount =
				CALCULATE(
					DISTINCTCOUNT(Dim_Date[FiscalMonth]),
					FILTER(
						ALL(Dim_Date[Date]),
						Dim_Date[Date] >= FYStartDate && Dim_Date[Date] <= CurrentDate
					)
				)
			VAR AvgMonthlySales = 
				DIVIDE(
					TotalFYTDSales,
					MonthCount,
					BLANK()
				)
			RETURN
				AvgMonthlySales
		formatString: #,##0.00
		displayFolder: Sales
		lineageTag: fc39f7e8-742b-419e-bc82-f3cfdda549d3

	measure 'Sales Amount PY' =
			VAR PYSales =
				CALCULATE(
					[Sales Amount],
					SAMEPERIODLASTYEAR(Dim_Date[Date])
				)
			RETURN
				PYSales
		formatString: #,##0.00
		displayFolder: Time Intelligence
		lineageTag: f934099f-b378-42f8-b42b-d332ece1a6b0

	measure 'Sales YOY %' =
			VAR CurrentYearSales = [Sales Amount]
			VAR PreviousYearSales = [Sales Amount PY]
			VAR YoYPct = 
				DIVIDE(
					CurrentYearSales - PreviousYearSales,
					PreviousYearSales,
					BLANK()
				)
			RETURN
				YoYPct
		formatString: 0.00%
		displayFolder: Time Intelligence
		lineageTag: 9ded44f3-a087-4a68-a06b-ba258a2cc818

	measure 'Item Discount %' =
			VAR TotalSales = [Sales Amount]
			VAR TotalDiscount = [Discount Amount]
			VAR DiscountPct = 
				DIVIDE(
					TotalDiscount,
					TotalSales,
					BLANK()
				)
			RETURN
				DiscountPct
		formatString: 0.00%
		displayFolder: Sales
		lineageTag: b0a4e62e-ad15-40b4-90db-36a4c1f4d354

	measure 'Budget Variance %' = [Sales vs Budget %]
		formatString: 0.00%
		displayFolder: Budget
		lineageTag: 8b77f73e-085a-4324-9445-08c5ffbd5020

	measure 'Item Budget Variance %' = [Sales vs Budget %]
		formatString: 0.00%
		displayFolder: Budget
		lineageTag: bf6f3c61-c1e5-4feb-98c9-49a5adffa73f

	measure 'Delivery Days Variance' =
			VAR TotalActualDays = SUM(Fact_Sales[Actual Delivery Days])
			VAR TotalExpectedDays = SUM(Fact_Sales[Expected Delivery Days])
			VAR VarianceDays = TotalActualDays - TotalExpectedDays
			RETURN
				VarianceDays
		formatString: #,##0
		displayFolder: Operations
		lineageTag: 6844f283-de5e-41f1-ad03-ca39cfcf894e

	measure 'On Time Delivery %' =
			VAR OnTimeOrders = 
				COUNTROWS(
					FILTER(
						Fact_Sales,
						Fact_Sales[Actual Delivery Days] <= Fact_Sales[Expected Delivery Days]
					)
				)
			VAR TotalOrders = COUNTROWS(Fact_Sales)
			VAR OnTimePct = 
				DIVIDE(
					OnTimeOrders,
					TotalOrders,
					BLANK()
				)
			RETURN
				OnTimePct
		formatString: 0.00%
		displayFolder: Operations
		lineageTag: b1427c70-edf3-46eb-8e55-4237719fd32d

	measure 'Fill Rate %' =
			VAR FilledOrders = 
				COUNTROWS(
					FILTER(
						Fact_Sales,
						Fact_Sales[Sales Amount LC] > 0
					)
				)
			VAR TotalOrders = COUNTROWS(Fact_Sales)
			VAR FillRatePct = 
				DIVIDE(
					FilledOrders,
					TotalOrders,
					BLANK()
				)
			RETURN
				FillRatePct
		formatString: 0.00%
		displayFolder: Operations
		lineageTag: 0c45002e-b327-46ec-8ee8-d8cd2d878255

	measure '# Transactions' =
			COUNTROWS(Fact_Sales)
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 7fe013d9-13ea-4350-82f1-df592a3ee349

	measure '# Customers' =
			DISTINCTCOUNT(Fact_Sales[CustomerKey])
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 36b764ba-1e16-4b6a-946b-219969a1869f

	measure 'Budget Status' =
			VAR SalesVal = [Sales Amount FYTD]
			VAR BudgetVal = [Budget Amount FYTD]
			VAR Ratio = DIVIDE(SalesVal, BudgetVal, 0)
			VAR StatusText =
				SWITCH(
					TRUE(),
					Ratio >= 1, "Above Target",
					Ratio >= 0.9, "Close to Target",
					"Below Target"
				)
			RETURN
				StatusText
		displayFolder: KPIs
		lineageTag: 2208231d-624a-4c8d-b2a5-ee882581803d

	partition _Measures = m
		mode: import
		source =
			let
				Source = #table({"Value"}, {{""}})
			in
				Source

