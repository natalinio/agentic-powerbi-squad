# Python virtual environment
.venv/
.env
.env.*
*.local

# Power BI local settings
**/.pbi/localSettings.json
**/.pbi/cache.abf
**/.pbi/editorSettings.json
**/.pbi/unappliedChanges.json

# OS files
Thumbs.db
.DS_Store

# IDE
.vscode/
*.code-workspace

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Project folders (user-created Power BI projects)
# Uncomment lines below to exclude your project folders from source control:
SalesOverview/
SalesAnalyticsPerformance/
# FinanceReport/
# CustomerAnalytics/
# (Keep [ProjectName]/ tracked as it's the template)

# Generated mock data (project-level data folders)
# Uncomment below to exclude CSVs from source control:
**/data/*.csv

# Test execution outputs (regenerated on each run)
**/tests/tests_execution.md
**/tests/tests_execution_raw.json
**/tests/report_validation_execution.md
**/tests/report_validation_execution_raw.json

# Workflow and local session state
**/workflow_state.json
**/agent_session_state.json

# Local backups
*.bak
*.backup
